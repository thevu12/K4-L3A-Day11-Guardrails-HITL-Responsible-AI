# Sao chép file này thành .env rồi điền giá trị thật.
# Không commit file .env hoặc khóa API lên GitHub.

# =============================================================================
# BLUE (CP2–CP3) — CỐ ĐỊNH OpenRouter liquid/lfm-2.5-2.6b
# https://openrouter.ai/liquid/lfm-2.5-2.6b
# =============================================================================
OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# =============================================================================
# RED + RED ADVANCE (CP4) — Gemini cho cả hai agent
# Model lab mặc định (điểm bắt buộc CP4): gemini-3.5-flash
# Model khó (tuỳ chọn khi săn bonus):       gemini-3.8-flash
# =============================================================================
RED_TEAM_PROVIDER=gemini

# --- gemini ---
GOOGLE_API_KEY=your-google-ai-studio-key-here
GOOGLE_GENAI_USE_VERTEXAI=0
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_MODEL=gemini-3.8-flash
